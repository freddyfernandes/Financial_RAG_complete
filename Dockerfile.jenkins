FROM --platform=linux/amd64 jenkins/jenkins:lts

USER root

# Base deps
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    git curl unzip ca-certificates lsb-release gnupg sudo \
    docker.io \
 && rm -rf /var/lib/apt/lists/*

# AWS CLI v2
RUN curl -sSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
 && unzip -q /tmp/awscliv2.zip -d /tmp \
 && /tmp/aws/install \
 && rm -rf /tmp/aws /tmp/awscliv2.zip

# kubectl
RUN curl -L "https://dl.k8s.io/release/$(curl -Ls https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl \
 && chmod +x /usr/local/bin/kubectl

# python -> python3
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Jenkins plugins
RUN jenkins-plugin-cli --plugins "git workflow-aggregator junit github-branch-source"

# Git safe directory (dubious ownership)
RUN git config --system --add safe.directory '*'

# Docker group + sudo
RUN groupadd -f docker \
 && usermod -aG docker,root jenkins \
 && echo "jenkins ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# If you need Docker builds, mount the host Docker socket when running the Jenkins container:
# -v /var/run/docker.sock:/var/run/docker.sock

USER root
